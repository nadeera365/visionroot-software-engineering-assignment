{
  "name": "visionroot-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed:admin": "node --env-file=.env src/scripts/seedAdmin.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test tests/rules.test.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.3.0"
  }
}
